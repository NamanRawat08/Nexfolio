# Application environment (e.g., development, production, test)
NODE_ENV=development

# Server port to listen on (e.g., 5001 - avoids macOS AirPlay receiver conflict on 5000)
PORT=5001

# Client origin allowed by CORS (e.g., http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection URL (passwords must use letters and digits only)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# JWT signing secret (at least 32 characters; generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"; never commit or share)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_HEX_STRING

# Redis URL for rate limiting (optional; e.g. redis://localhost:6379). When set, limits are counted
# in Redis, shared by every server instance and kept across restarts, and fall back to in-memory
# counting if Redis is unreachable. When unset, limits are counted in memory, per process.
# REDIS_URL=redis://localhost:6379

# Redis key prefix for rate limits (optional; instances with the same prefix share limits)
# RATE_LIMIT_PREFIX=nexfolio:rl

# Number of reverse proxies in front of the server (optional; 0-10). Set it when deployed behind a
# load balancer so rate limiting sees the real client IP. Leave unset for none.
# TRUST_PROXY=1
